# Car Price Prediction - Environment Variables
# Copy to .env and modify as needed

# Data paths (override config.yaml)
# CAR_PRICE_DATA_RAW_DIR=data/raw
# CAR_PRICE_DATA_PROCESSED_DIR=data/processed

# Model settings
# CAR_PRICE_MODEL_USE_OPTUNA=true
# CAR_PRICE_MODEL_OPTUNA_TRIALS=50
# CAR_PRICE_MODEL_OPTUNA_TIMEOUT=1800

# Output
# CAR_PRICE_OUTPUT_MODEL_DIR=models
# CAR_PRICE_OUTPUT_REPORTS_DIR=reports

# WandB / MLflow (optional)
# WANDB_API_KEY=your_key_here
# MLFLOW_TRACKING_URI=http://localhost:5000